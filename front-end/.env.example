# A API é alcançada em same-origin via proxy do Next (/api → Django em
# loopback, ver next.config.ts) — não é preciso configurar a URL da API.
# Só defina a variável abaixo se a API rodar em OUTRO domínio (aí o Django
# precisa aceitar a origem em CORS_ALLOWED_ORIGINS):
# NEXT_PUBLIC_API_BASE_URL=https://api.exemplo.com/api
# enabled: demo completa sem backend (MSW cuida de auth, agenda e arena no npm run dev).
# disabled: sem MSW, tudo real (Django) — padrão; todas as telas usam a API real.
# Mocking is always disabled in production builds.
NEXT_PUBLIC_API_MOCKING=disabled
