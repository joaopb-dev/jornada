NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# enabled: demo completa sem backend (MSW cuida de auth, agenda e arena no npm run dev).
# disabled: sem MSW, tudo real (Django) — padrão; todas as telas usam a API real.
# Mocking is always disabled in production builds.
NEXT_PUBLIC_API_MOCKING=disabled
